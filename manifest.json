{
  "manifest_version": 3,
  "name": "Airport Display",
  "version": "1.0.0",
  "description": "A split-flap airport departures board for your new tab: date, time, weather and today's Google Calendar meetings, with mechanical flap sounds.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage", "identity", "geolocation"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.readonly"]
  }
}
